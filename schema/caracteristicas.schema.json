{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ficha-facil.local/caracteristicas.schema.json",
  "title": "Coleção de Características",
  "type": "object",
  "required": [
    "colecao",
    "total",
    "itens"
  ],
  "properties": {
    "colecao": {
      "const": "caracteristicas"
    },
    "total": {
      "type": "integer"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "fonte",
          "revisao",
          "descricao_curta"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "nome": {
            "type": "string"
          },
          "classe": {
            "type": "string"
          },
          "subclasse": {
            "type": "string"
          },
          "nivel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "niveis_repetidos": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "descricao_curta": {
            "type": "string",
            "maxLength": 600
          },
          "fonte": {
            "$ref": "https://ficha-facil.local/fonte.schema.json"
          },
          "revisao": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "duvida",
                  "conflito_2014"
                ]
              }
            }
          },
          "efeitos": {
            "type": "array",
            "items": {
              "$ref": "https://ficha-facil.local/efeito.schema.json"
            }
          },
          "escopo": {
            "enum": [
              "generico",
              "todo_personagem"
            ],
            "description": "'generico': a característica é de várias classes, e o nível vive na progressão de cada uma. 'todo_personagem': vem da criação (cap. 2) e não de espécie, antecedente nem classe — é o caso dos idiomas iniciais (p. 37)."
          },
          "tipo_de_entrada": {
            "enum": [
              "caracteristica",
              "marcador"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "properties": {
                  "escopo": {
                    "enum": [
                      "generico",
                      "todo_personagem"
                    ]
                  }
                },
                "required": [
                  "escopo"
                ]
              }
            },
            "then": {
              "required": [
                "classe",
                "nivel",
                "efeitos"
              ]
            }
          }
        ]
      }
    }
  }
}