{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ficha-facil.local/acoes.schema.json",
  "title": "Coleção de Ações",
  "type": "object",
  "required": ["colecao", "total", "itens"],
  "properties": {
    "colecao": { "const": "acoes" },
    "total": { "type": "integer" },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nome", "custo", "fonte", "revisao", "descricao_curta"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "nome": { "type": "string" },
          "custo": { "enum": ["acao", "acao_bonus", "reacao", "livre"] },
          "descricao_curta": { "type": "string", "maxLength": 500 },
          "fonte": { "$ref": "https://ficha-facil.local/fonte.schema.json" },
          "revisao": { "type": "object", "required": ["status"] },
          "teste": { "type": "object" },
          "opcoes": { "type": "array" },
          "efeitos": { "type": "array", "items": { "$ref": "https://ficha-facil.local/efeito.schema.json" } },
          "encerramento": { "type": "array" },
          "perde_beneficio_se": { "type": "array" }
        }
      }
    }
  }
}
