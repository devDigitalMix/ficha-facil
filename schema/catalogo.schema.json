{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ficha-facil.local/catalogo.schema.json",
  "title": "Catálogo canônico",
  "type": "object",
  "required": [
    "catalogo",
    "nome",
    "total",
    "itens"
  ],
  "properties": {
    "catalogo": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "nome": {
      "type": "string"
    },
    "nota": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "fonte": {
      "$ref": "https://ficha-facil.local/fonte.schema.json"
    },
    "itens": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z0-9_]+|[A-Z]{3})$"
          },
          "nome": {
            "type": "string"
          },
          "descricao_curta": {
            "type": "string"
          },
          "fonte": {
            "$ref": "https://ficha-facil.local/fonte.schema.json"
          }
        }
      }
    },
    "preenchida": {
      "type": "boolean"
    },
    "parcial": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "total": {
            "const": 0
          }
        },
        "required": [
          "total"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "preenchida": {
                "const": false
              }
            },
            "required": [
              "preenchida"
            ]
          },
          {
            "properties": {
              "parcial": {
                "const": true
              }
            },
            "required": [
              "parcial"
            ]
          }
        ],
        "description": "catálogo vazio só é válido se declarado pendente"
      }
    }
  ]
}