{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ficha-facil.local/condicoes.schema.json",
  "title": "Coleção de Condições",
  "type": "object",
  "required": ["colecao", "total", "itens"],
  "properties": {
    "colecao": { "const": "condicoes" },
    "total": { "type": "integer" },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nome", "fonte", "revisao", "descricao_curta", "efeitos"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "nome": { "type": "string" },
          "descricao_curta": { "type": "string", "maxLength": 400 },
          "fonte": { "$ref": "https://ficha-facil.local/fonte.schema.json" },
          "revisao": {
            "type": "object", "required": ["status"],
            "properties": { "status": { "enum": ["ok", "duvida", "conflito_2014"] }, "notas": { "type": "string" } }
          },
          "acumulativa": { "type": "boolean" },
          "nivel_maximo": { "type": "integer" },
          "efeito_no_nivel_maximo": { "type": "string" },
          "efeitos": { "type": "array", "items": { "$ref": "https://ficha-facil.local/efeito.schema.json" } },
          "encerramento": { "type": "array", "items": { "type": "object", "required": ["gatilho"] } }
        }
      }
    }
  }
}
