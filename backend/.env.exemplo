# Ficha Fácil — backend
#
# Copie para `backend/.env` e preencha — é o caminho que `npm run servir` lê. O `.env`
# não vai para o git; este arquivo vai, e serve de documentação dos nomes que existem.
#
# Node 22 lê o arquivo sozinho, sem dotenv:
#     cd backend && npm run servir
#
# Marcadores: [lido hoje] o código já usa; [a escrever] entra com o passo
# correspondente do PLANO-FASE-A.md.
#
# Nada aqui é obrigatório: sem arquivo nenhum o backend sobe, guarda em arquivo e
# assina a sessão com um segredo gerado na hora. O que muda ao preencher está dito
# em cada bloco.

# ------------------------------------------------------------- servidor [lido hoje]
PORTA=8787

# --------------------------------------------------- armazém em arquivo [lido hoje]
# Onde os personagens ficam enquanto o Mongo não entra. Continua útil depois:
# é o modo de rodar e testar sem banco nenhum.
PERSONAGENS=./personagens

# ---------------------------------------------------------------- Mongo [lido hoje]
# String de conexão do cluster do Atlas, com usuário e senha.
# Formato: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Nome do banco dentro do cluster.
MONGODB_BANCO=ficha_facil
# Quando vazio ou ausente, o backend usa PERSONAGENS e não abre conexão nenhuma —
# nem sequer carrega o driver. Quem decide é `src/principal.ts`, num lugar só.
#
# Os testes do Mongo se pulam sozinhos sem um banco. Para rodá-los de verdade:
#     MONGODB_URI_TESTE='mongodb+srv://…' npm run teste
# Use um banco DESCARTÁVEL: o teste cria e apaga coleções.
MONGODB_URI_TESTE=

# --------------------------------------------------------------- contas [lido hoje]
# Segredo para assinar o token de sessão. Gere um novo, e não reaproveite de outro projeto:
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Sem ele o backend gera um a cada subida — seguro, mas todo mundo é deslogado a cada
# reinício do servidor. Para uso de verdade, defina.
SESSAO_SEGREDO=
# Validade da sessão, em horas.
SESSAO_HORAS=720

# ------------------------------------------------------- imagens no S3 [a escrever]
# Bucket PRIVADO. O backend nunca serve o arquivo: ele assina URLs de curta validade.
S3_BUCKET=
S3_REGIAO=us-east-1
S3_CHAVE_ID=
S3_CHAVE_SECRETA=
# Validade das URLs assinadas, em segundos.
S3_URL_SEGUNDOS=300
